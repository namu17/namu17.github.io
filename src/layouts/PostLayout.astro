---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import Toc from '../components/Toc.astro';
import { CATEGORY_LABEL } from '../consts';
import { formatDate, type Post, postUrl, tagSlug } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	prev?: Post;
	next?: Post;
}

const { post, headings, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, category, topic, tags, ctf, heroImage } = post.data;

// 상단 경로: home / ctf / pwn / baby-heap.md
const fileName = `${post.id.split('/').pop()}.md`;
const path = [
	{ label: category, href: `/categories/${category}/` },
	{ label: topic, href: `/categories/${category}/${tagSlug(topic)}/` },
	{ label: fileName },
];
---

<BaseLayout title={title} description={description} path={path} image={heroImage} wide>
	<div class="post">
		<article class="post__body" data-pagefind-body>
			<header class="post__head">
				<div class="post__kicker" data-pagefind-ignore>
					<a href={`/categories/${category}/`} class={`cat-${category}`}>
						{CATEGORY_LABEL[category]} · {topic}
					</a>
					{
						ctf && (
							<>
								<span aria-hidden="true">·</span>
								<span>{ctf.event}</span>
							</>
						)
					}
					{
						ctf?.difficulty && (
							<>
								<span aria-hidden="true">·</span>
								<span>{ctf.difficulty}</span>
							</>
						)
					}
				</div>
				<h1 class="post__title">{title}</h1>
				<div class="post__meta" data-pagefind-ignore>
					<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
					{updatedDate && <span>(수정 {formatDate(updatedDate)})</span>}
					{
						tags.length > 0 && (
							<span class="post__tags">
								{tags.map((t) => (
									<a href={`/tags/${tagSlug(t)}/`} class="tag-chip">
										#{t}
									</a>
								))}
							</span>
						)
					}
				</div>
			</header>

			{heroImage && <Image class="post__hero" src={heroImage} alt="" width={1020} />}

			<div class="prose">
				<slot />
			</div>

			{
				(prev || next) && (
					<nav class="pager" aria-label="이전, 다음 글" data-pagefind-ignore>
						{prev ? (
							<a href={postUrl(prev)} class="pager__link">
								<span class="pager__label">← 이전 글</span>
								<span class="pager__title">{prev.data.title}</span>
							</a>
						) : (
							<span />
						)}
						{next && (
							<a href={postUrl(next)} class="pager__link pager__link--next">
								<span class="pager__label">다음 글 →</span>
								<span class="pager__title">{next.data.title}</span>
							</a>
						)}
					</nav>
				)
			}
		</article>

		<aside class="post__toc">
			<Toc headings={headings} />
		</aside>
	</div>
</BaseLayout>

<style>
	.post {
		display: flex;
		flex-wrap: wrap;
		gap: 48px;
		padding-top: 8px;
	}

	.post__body {
		flex: 999 1 560px;
		min-width: 0;
	}

	.post__toc {
		flex: 1 1 200px;
	}

	.post__head {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding-bottom: 24px;
		margin-bottom: 8px;
		border-bottom: 1px solid var(--border);
	}

	.post__kicker {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		font-size: 13px;
		font-weight: 600;
		color: var(--muted);
	}

	.post__title {
		margin: 0;
		font-size: 34px;
		line-height: 1.35;
		font-weight: 700;
		color: var(--heading);
	}

	.post__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 16px;
		font-size: 14px;
		color: var(--muted);
	}

	.post__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.post__hero {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 24px;
		border-radius: var(--radius);
	}

	.pager {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
		margin-top: 56px;
	}

	.pager__link {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 18px 20px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.pager__link--next {
		text-align: right;
	}

	.pager__label {
		font-size: 12px;
		color: var(--muted);
	}

	.pager__title {
		font-size: 15px;
		font-weight: 600;
		color: var(--heading);
	}

	@media (max-width: 960px) {
		.post__toc {
			display: none;
		}

		.post__title {
			font-size: 27px;
		}

		.pager {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
