---
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} path={[]}>
	<h1 class="page-title">Recent Posts</h1>
	<p class="page-desc">{SITE_DESCRIPTION}</p>
	<div class="list">
		{posts.length ? posts.map((post) => <PostCard post={post} />) : <p class="empty">아직 글이 없습니다.</p>}
	</div>
</BaseLayout>

<style>
	.list {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
</style>
