---
import { AUTHOR } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description={`${AUTHOR.name} 소개`} path={[{ label: 'about.md' }]}>
	<h1 class="page-title">About</h1>
	<div class="prose">
		<p>[자기소개를 적어주세요. 이 파일은 src/pages/about.astro 입니다.]</p>
		<h2>관심 분야</h2>
		<ul>
			<li>Cloud Security: [예: AWS, Kubernetes]</li>
			<li>CTF: [예: pwn, web]</li>
		</ul>
		<h2>활동</h2>
		<ul>
			<li>[참가한 CTF, 자격증, 프로젝트 등]</li>
		</ul>
	</div>
</BaseLayout>
